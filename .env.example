# --- App ---
PORT=3000
APP_PORT=3000

# --- Base de datos ---
# Local: DB_HOST=mysql (servicio del docker-compose.yml)
# Servidor: nombre del container de la base dentro de tmob_network
DB_HOST=mysql
DB_PORT=3306
DB_NAME=tmob
DB_USER=clickmaster
DB_PASSWORD=clickmaster
# Solo lo usa el container MySQL local
DB_ROOT_PASSWORD=root
MYSQL_HOST_PORT=3307

# --- API de CDRs ---
# Local: la API mock. Servidor: la URL real.
API_URL=http://mock-api/cdrs.json
API_TOKEN=
MOCK_API_HOST_PORT=8080

# --- Checker (Playwright) ---
# % de los SMS con link (elegidos al azar en cada corrida) a los que se les hace click
CLICK_PERCENTAGE=30
CHECK_CONCURRENCY=8
LINK_CHECK_TIMEOUT_MS=15000

# --- Clicks manuales (POST /clicks) ---
# Maximo de visitas que se pueden pedir en un solo job
CLICK_JOB_MAX_COUNT=1000
# Cuanto se queda cada sesion de browser en la pagina (al azar en el rango)
CLICK_DWELL_MIN_MS=3000
CLICK_DWELL_MAX_MS=7000
# true = no descargar imagenes, fuentes ni video (menos CPU/RAM por sesion;
# los pixeles de tracking que sean imagenes no se disparan)
CLICK_BLOCK_RESOURCES=false
