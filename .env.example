# =============================================================================
# ClickMaster - plantilla de configuracion para el SERVIDOR
# Copiar a .env (make env) y completar todo lo marcado con [COMPLETAR].
# .env NO se versiona: tiene credenciales.
#
# Para correr LOCAL con el mock en vez de Alaris:
#   COMPOSE_PROFILES=mock   y   EDR_URL=http://mock-edr:8080/
# =============================================================================

# --- Docker Compose ---
# Vacio en el servidor (no levanta el mock). "mock" solo para desarrollo local.
COMPOSE_PROFILES=

# --- App ---
PORT=3000
# Puerto publicado en 127.0.0.1 del servidor (no queda expuesto afuera)
APP_PORT=3000
# info en produccion; debug loguea cada visita (mucho volumen)
LOG_LEVEL=info
# Recomendado si la app se expone fuera de localhost: todo salvo /health pide
# "Authorization: Bearer <token>" (el Makefile lo manda solo).
ADMIN_TOKEN=

# --- Base de datos ---
# DB_HOST=mysql usa el MySQL del docker-compose (datos en el volumen mysql_data).
# Para una base externa: su host/IP (el container sale por la red frontend).
# [COMPLETAR si la base es externa]
DB_HOST=mysql
DB_PORT=3306
# [COMPLETAR] base donde vive sms_content
DB_NAME=
# [COMPLETAR] SELECT/INSERT/UPDATE en sms_content + CREATE/ALTER para las tablas auxiliares
DB_USER=
# [COMPLETAR]
DB_PASSWORD=
# Solo para el MySQL del docker-compose (y make test). Con base externa no se usa.
# [COMPLETAR si se usa el MySQL del compose]
DB_ROOT_PASSWORD=
DB_CONNECTION_LIMIT=10

# --- API EDR de Alaris (JSON-RPC Enterprise.Cursor / get_sms_edr) ---
# Restringida por IP: solo responde desde el servidor.
# [COMPLETAR] URL del endpoint JSON-RPC
EDR_URL=
# Va en params.auth del request. Nunca se loguea ni se devuelve.
# [COMPLETAR]
EDR_AUTH=
# Bearer en el header, solo si Alaris lo pide ademas del auth del body.
API_TOKEN=
EDR_METHOD=Enterprise.Cursor
EDR_CURSOR_NAME=get_sms_edr
# [COMPLETAR] ej. 1286
EDR_CLIENT_PRODUCT_ID=
# [CONFIRMAR] vacio = sin filtro de pais
EDR_COUNTRY=Brazil
# Zona de las fechas de Alaris (start_date/end_date y edr_date), sin horario de verano
EDR_TIMEZONE_OFFSET=-03:00
# Alaris no pagina: devuelve la ventana entera (~20.000 SMS, ~40 MB) en una
# sola respuesta que puede tardar varios minutos. Este es el tiempo maximo
# para recibirla completa. 600000 = 10 min.
EDR_HTTP_TIMEOUT_MS=600000
# Reintentos si la API falla, no responde o se pasa del timeout. Cada uno
# puede volver a tardar minutos: con 1, una ventana con problemas tarda como
# mucho 2 x EDR_HTTP_TIMEOUT_MS antes de quedar failed (se reintenta en el
# proximo tick del scheduler igual).
EDR_MAX_RETRIES=1
# Si una respuesta trae este numero de filas o mas se asume truncada y la
# ventana se pide de nuevo en dos mitades (hasta EDR_MIN_SPLIT_SECONDS).
# Si Alaris NO corta en un tope fijo, poner 0 (no parte nunca).
# [CONFIRMAR con make edr-probe]
EDR_MAX_ROWS_PER_REQUEST=20000
EDR_MIN_SPLIT_SECONDS=60
MOCK_API_HOST_PORT=8080

# --- Scheduler (ingesta automatica) ---
SCHEDULER_ENABLED=true
EDR_WINDOW_MINUTES=30
# Cada cuanto se fija si hay una ventana cerrada para pedir (no es el tamano de la ventana)
SCHEDULER_TICK_SECONDS=60
# Margen despues del cierre de la ventana antes de pedirla (EDR que llegan tarde)
EDR_SAFETY_DELAY_MINUTES=5
# Cada consulta arranca este tanto antes, para levantar EDR tardios o cambios
# de status (se deduplican). 0 = sin solapamiento.
EDR_OVERLAP_MINUTES=0
# Primera ventana si la base no tiene corridas, en hora de Alaris
# ("YYYY.MM.DD HH:mm:ss"). Vacio = arranca por la ultima ventana cerrada.
# [COMPLETAR si hay que recuperar ventanas pasadas]
EDR_START_DATE=
# Ventanas atrasadas por tick (con requests de varios minutos, un tick puede durar bastante)
EDR_MAX_WINDOWS_PER_TICK=6
INGEST_DB_BATCH_SIZE=500
# 0 = no purgar. Si no, borra sms_link_checks y sync_runs con mas de N dias.
RESULTS_RETENTION_DAYS=0

# --- Worker (cola persistente + Playwright) ---
WORKER_ENABLED=true
# % de los SMS con link que se verifican (muestra al azar). Con 4 sesiones se
# verifican ~3.600 cada 30 min: con 20.000 por ventana, 100 hace crecer la
# cola sin limite. Ajustar mirando queueLagSeconds en `make queue`.
# [DECIDIR]
CLICK_PERCENTAGE=15
# Limite global de sesiones de Chromium (worker y clicks manuales lo comparten).
# Servidor de 1 nucleo / 2 GB: no pasar de 4-6.
CHECK_CONCURRENCY=4
LINK_CHECK_TIMEOUT_MS=15000
WORKER_CLAIM_BATCH_SIZE=8
WORKER_POLL_INTERVAL_MS=5000
WORKER_LEASE_MS=300000
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_DELAY_MS=60000
WORKER_BROWSER_IDLE_CLOSE_MS=60000
WORKER_RECOVERY_INTERVAL_MS=60000

# --- Clicks manuales (POST /clicks) ---
# Maximo de visitas que se pueden pedir en un solo job
CLICK_JOB_MAX_COUNT=1000
# Cuanto se queda cada sesion de browser en la pagina (al azar en el rango)
CLICK_DWELL_MIN_MS=3000
CLICK_DWELL_MAX_MS=7000
# true = no descargar imagenes, fuentes ni video (menos CPU/RAM por sesion;
# los pixeles de tracking que sean imagenes no se disparan)
CLICK_BLOCK_RESOURCES=false
