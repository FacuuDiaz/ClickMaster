{
  "name": "sms-link-checker",
  "version": "1.0.0",
  "private": true,
  "description": "Ingesta automatica de SMS EDR (JSON-RPC) en sms_content y verificacion de sus links con Playwright desde una cola persistente en MySQL.",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "sync:once": "tsx src/cli.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/unit/*.test.ts test/integration/*.test.ts",
    "test:volume": "node --import tsx --test --test-concurrency=1 test/volume/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "mysql2": "^3.11.3",
    "p-limit": "^3.1.0",
    "playwright": "1.48.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
