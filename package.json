{
  "name": "sms-link-checker",
  "version": "1.0.0",
  "private": true,
  "description": "Fetchea CDRs de SMS desde una API, los carga en sms_content (MariaDB) y verifica en paralelo con Playwright los links embebidos en el campo text.",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "sync:once": "tsx src/cli.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "mysql2": "^3.11.3",
    "p-limit": "^3.1.0",
    "playwright": "1.48.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
